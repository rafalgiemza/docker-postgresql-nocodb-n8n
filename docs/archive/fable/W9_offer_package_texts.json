    {
      "parameters": {
        "jsCode": "// AI Agent zawiodl po probach retry. Task NAJPIERW (potrzebujemy jego Id do\n// linku), dopiero potem wpis w POLU WYNIKOWYM (generated_text) - dokladnie\n// wzorzec \"Loguj blad w polu needs_summary\" z W11, zastosowany konsekwentnie\n// (user: \"wszedzie gdzie uzywamy AI... bledy logujemy w polu gdzie mial byc\n// wynik + link do taska\").\nconst src = $('Assemble prompt').item.json;\nconst err = $input.first().json;\nreturn [{ json: { ...src,\n  task: { title: `BLAD generowania opisu pakietu \"${src.package_name}\" (offer_package #${src.offer_package_id})`,\n          status: 'todo', priority: 'high', assignee: src.methodologist,\n          created_by_flow: 'W12',\n          description: `offer_package:${src.offer_package_id} offer:${src.offer_id}\\n`\n            + JSON.stringify(err).slice(0, 500) },\n  activity: { summary: `Generowanie opisu pakietu NIEUDANE (offer_package #${src.offer_package_id})`,\n              type: 'automation_error', flow: 'W12', triggered_by: 'system',\n              payload: JSON.stringify({ offer_package_id: src.offer_package_id, error: err }).slice(0, 800) },\n} }];\n"
      },
