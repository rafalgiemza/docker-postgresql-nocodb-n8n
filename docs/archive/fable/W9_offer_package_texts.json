      "parameters": {
        "jsCode": "// Task juz istnieje ($json.Id = jego Id, z poprzedniego node'a \"create\") -\n// zbuduj komunikat + link do niego, zeby wpisac go w generated_text (pole,\n// w ktorym mial byc wynik). ai_status='none' (nie 'ai_rejected'): transient\n// blad LLM ma zostac klikalny ponownie od razu, bez akcji czlowieka.\nconst taskId = $json.Id;\nconst src = $('Prepare LLM error payload').item.json;\nconst TASK_URL = `__NOCODB_BASE_URL__/__WORKSPACE_ID__/__PROJECT_ID__/__TBL_TASKS__/__VIEW_TASKS_ID__/tasks-tasks?rowId=${taskId}`;\nreturn [{ json: {\n  offer_package_id: src.offer_package_id,\n  ai_status: 'none',\n  generated_text: `Generowanie nie powiodlo sie. Szczegoly w tasku: <a href=\"${TASK_URL}\">link</a>`,\n  activity: src.activity,\n} }];\n"
      },
