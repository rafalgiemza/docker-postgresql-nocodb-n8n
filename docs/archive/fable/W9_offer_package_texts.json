    {
      "parameters": {
        "jsCode": "// Sukces AI Agenta -> draft generated_text, task weryfikacji, activity.\nconst src = $('Assemble prompt').item.json;\nconst res = $input.first().json;\nconst content = (res.output || '').trim();\nif (!content) throw new Error('Pusta odpowiedz LLM: ' + JSON.stringify(res).slice(0, 400));\nreturn [{ json: { ...src,\n  patch: { Id: src.offer_package_id, generated_text: content, ai_status: 'ai_draft_ready' },\n  task: { title: `Zweryfikuj opis pakietu \"${src.package_name}\" (offer_package #${src.offer_package_id})`,\n          status: 'todo', priority: 'high', assignee: src.methodologist,\n          created_by_flow: 'W12',\n          description: `offer_package:${src.offer_package_id} offer:${src.offer_id}` },\n  activity: { summary: `AI opis pakietu gotowy do weryfikacji (offer_package #${src.offer_package_id})`,\n              type: 'ai_analysis_done', flow: 'W12', triggered_by: 'system',\n              payload: JSON.stringify({ offer_package_id: src.offer_package_id, offer_id: src.offer_id,\n                model: 'anthropic/claude-sonnet-4.5' }) }\n} }];\n"
      },
