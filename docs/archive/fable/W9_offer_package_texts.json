        "jsCode": "// offer_packages bez wybranego package_variant (wiersz utworzony, ale link\n// nie uzupelniony) - nie wolaj LLM na pusto. Lead/company sa juz pobrane\n// (Get offer/Get lead/Get company sa PRZED tym IF), wiec metodolog jest\n// znany - w odroznieniu od W11 \"Prepare missing-data payload\", gdzie\n// assignee zostal pusty (methodologist = '' w zywym pliku).\nconst guard = $('Guard').item.json;\nconst lead = $('Get lead').item.json || {};\nconst methodologist = lead.lead_type === 'B2B' ? 'dorota@coaction.pl' : 'aleksandra@coaction.pl';\nreturn [{ json: {\n  offer_package_id: guard.offer_package_id,\n  task: { title: `Uzupelnij wariant pakietu przed generowaniem opisu (offer_package #${guard.offer_package_id})`,\n          status: 'todo', priority: 'normal', assignee: methodologist,\n          created_by_flow: 'W12',\n          description: `offer_package:${guard.offer_package_id} offer:${guard.offer_id}` },\n  activity: { summary: `Opis pakietu: brak wybranego wariantu (offer_package #${guard.offer_package_id})`,\n              type: 'automation_error', flow: 'W12', triggered_by: 'user',\n              payload: JSON.stringify({ offer_package_id: guard.offer_package_id }) },\n} }];\n"
