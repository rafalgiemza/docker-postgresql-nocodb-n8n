    {
      "parameters": {
        "jsCode": "\nconst src = $('Keep meeting drafts waiting more than a day').all();\nconst res = $input.all();\nconst today = new Date().toISOString().slice(0, 10);\nconst out = [];\nsrc.forEach((s, i) => {\n  const list = (res[i] && res[i].json && res[i].json.list) || [];\n  const open = list.some(t => t.task_type === 'approve_ai_draft' && t.status !== 'done' && t.status !== 'cancelled');\n  if (!open) out.push({ json: { ...s.json, role: 'handlowiec', on_date: today, due_date: today,\n    task_title: 'Zatwierdź szkic AI (meeting): ' + s.json.title } });\n});\nreturn out;\n"
      },
