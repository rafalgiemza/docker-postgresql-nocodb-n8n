        "jsCode": "\n// Jeden nowy task -> trzy linki (przypisany, ocena, osoba); wyjątek od \"Set zamiast Code\":\n// rozwija jeden item na kilka.\nconst FIELD = {\n  'employees': '__COL_EMPLOYEES__TASKS__',\n  'assessments': '__COL_ASSESSMENTS__TASKS__',\n  'persons': '__COL_PERSONS__TASKS__',\n};\nconst TBL = {\n  'employees': '__TBL_EMPLOYEES__',\n  'assessments': '__TBL_ASSESSMENTS__',\n  'persons': '__TBL_PERSONS__',\n};\nconst g = $('Assessment from button').first().json;\nconst a = $('Attach task details to the assignee').first().json;\nconst tid = $input.first().json.Id;\nconst link = (table, recordId) => (recordId && tid)\n  ? { json: { table_id: TBL[table], field_id: FIELD[table], record_id: recordId, body: JSON.stringify([{ Id: tid }]) } }\n  : null;\nreturn [link('employees', a.assignee_id), link('assessments', g.assessment_id), link('persons', g.person_id)].filter(Boolean);\n"
      },
