    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "// Laczenie zdarzenia kalendarza z ewentualnym dopasowaniem w leads/participants.\n// Przy kilku trafieniach bierzemy najnowszy rekord (najwyzsze Id), tak jak w W9/W5.\nconst ev = $('Filter new events').item.json;\nconst leadMatches = ($('Find matching lead').item.json.list) || [];\nconst participantMatches = ($('Find matching participant').item.json.list) || [];\n\nconst lead = leadMatches.slice().sort((a, b) => b.Id - a.Id)[0] || null;\nconst participant = participantMatches.slice().sort((a, b) => b.Id - a.Id)[0] || null;\n\nreturn { json: {\n  ...ev,\n  lead_id: lead ? lead.Id : null,\n  lead_name: lead ? lead.lead_name : null,\n  participant_id: participant ? participant.Id : null,\n  participant_name: participant ? participant.full_name : null,\n  has_lead: !!lead,\n  has_participant: !!participant,\n} };"
      },
