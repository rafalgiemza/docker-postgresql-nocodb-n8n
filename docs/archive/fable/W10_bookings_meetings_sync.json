      "parameters": {
        "method": "GET",
        "url": "=https://graph.microsoft.com/v1.0/me/calendarView?startDateTime={{ $json.startDateTime }}&endDateTime={{ $json.endDateTime }}&$top=999&$orderby=start/dateTime",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "microsoftOutlookOAuth2Api",
        "options": {},
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Prefer",
              "value": "outlook.timezone=\"UTC\""
            }
          ]
        }
      },
