    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Nowe wydarzenia z kalendarza MS Bookings: odsiej anulowane i juz zsynchronizowane\n// (po external_id = Graph event id). Znany uproszczenie: nie obslugujemy tu odswiezania\n// juz zsynchronizowanych spotkan przy zmianie godziny/tytulu w kalendarzu ani propagacji\n// anulowania - patrz README sekcja \"Znane uproszczenia\".\nconst events = ($('Fetch Outlook events').first().json.value) || [];\nconst existingIds = new Set($input.all().map(i => i.json.external_id).filter(Boolean));\n\nconst out = [];\nfor (const ev of events) {\n  if (ev.isCancelled) continue;\n  if (!ev.id || existingIds.has(ev.id)) continue;\n\n  const attendee = (ev.attendees || [])[0] || {};\n  const email = String((attendee.emailAddress && attendee.emailAddress.address) || '').trim().toLowerCase();\n  const name = (attendee.emailAddress && attendee.emailAddress.name) || email || '';\n  const location = ev.location && ev.location.displayName ? `\\nLokalizacja: ${ev.location.displayName}` : '';\n  const teamsLink = ev.onlineMeeting && ev.onlineMeeting.joinUrl ? `\\nLink: ${ev.onlineMeeting.joinUrl}` : '';\n\n  out.push({ json: {\n    external_id: ev.id,\n    title: ev.subject || `Spotkanie z ${name || 'nieznanym kontaktem'}`,\n    starts_at: ev.start && ev.start.dateTime ? ev.start.dateTime + 'Z' : null,\n    ends_at: ev.end && ev.end.dateTime ? ev.end.dateTime + 'Z' : null,\n    customer_name: name,\n    customer_email: email,\n    notes: `Zsynchronizowano z MS Bookings (kalendarz p.fidzina@coaction.com).\\n` +\n           `Klient: ${name}${email ? ' <' + email + '>' : ''}${location}${teamsLink}\\n\\n` +\n           `${ev.bodyPreview || ''}`,\n  } });\n}\nreturn out;"
      },
