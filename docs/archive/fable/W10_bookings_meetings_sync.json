      "id": "w10-04",
      "name": "Fetch existing meetings",
      "type": "n8n-nodes-base.nocoDb",
      "typeVersion": 3,
      "position": [
        -1800,
        0
      ],
      "alwaysOutputData": true,
      "credentials": {
        "nocoDbApiToken": {
          "id": "fuKl7juoVU9L7ZqE",
          "name": "NocoDB Token account"
        }
