    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// -7 / +60 dni od teraz - okno synchronizacji kalendarza.\nconst now = new Date();\nconst start = new Date(now.getTime() - 7 * 24 * 60 * 60 * 1000);\nconst end = new Date(now.getTime() + 60 * 24 * 60 * 60 * 1000);\nreturn [{ json: { startDateTime: start.toISOString(), endDateTime: end.toISOString() } }];"
      },
      "id": "w10-02",
      "name": "Build date window",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -2200,
        0
      ]
    },
