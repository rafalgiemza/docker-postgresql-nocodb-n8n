    {
      "parameters": {
        "jsCode": "const FIELD = {\n \"persons.bought_opportunities\": \"ck5jkdn5f4dadnp\",\n \"leads.opportunities\": \"cpvgaer9v6h69yp\",\n \"employees.opportunities\": \"c9ssurqn7ppm0c1\",\n \"companies.opportunities\": \"ch3qnvrhuo1wc2s\",\n \"sale_opportunities.history\": \"cxxcfkznvd4gh83\",\n \"sale_opportunities.activities\": \"co11vdft4h2hp2h\"\n};\n\nconst TBL = t => $('Get one base').first().json.tables.find(x => x.title === t).id;\nconst link = (table, field, recordId, targetIds) => {\n  const ids = (Array.isArray(targetIds) ? targetIds : [targetIds]).filter(Boolean);\n  if (!recordId || !ids.length) return null;\n  return { json: { table_id: TBL(table), field_id: FIELD[table + '.' + field],\n                   record_id: recordId, body: JSON.stringify(ids.map(Id => ({ Id }))) } };\n};\n\nconst a = $('Assemble new opportunity').first().json;\nconst opp = $('Create sale opportunity').first().json.Id;\nreturn [\n  link('persons', 'bought_opportunities', a.person_id, opp),\n  link('leads', 'opportunities', a.source_lead_id, opp),\n  link('employees', 'opportunities', a.owner_id, opp),\n  link('companies', 'opportunities', a.company_id, opp),\n  link('sale_opportunities', 'history', opp, $('Create first stage history row').first().json.Id),\n  link('sale_opportunities', 'activities', opp, $('Log activity: opportunity created').first().json.Id),\n].filter(Boolean);\n"
      },
