    {
      "parameters": {
        "authentication": "nocoDbApiToken",
        "workspaceId": "={{ $('Get one base').first().json.workspace_id }}",
        "projectId": "={{ $('Get one base').first().json.id }}",
        "table": "={{ $('Get one base').first().json.tables.find(t => t.title === 'tasks').id }}",
        "operation": "getAll",
        "returnAll": true,
        "options": {
          "where": "=(created_by_flow,eq,W0)~and(due_date,ge,{{ $now.toFormat('yyyy-MM-dd') }})"
        }
      },
      "id": "get-already-created-recurring-tasks",
      "name": "Get already created recurring tasks",
      "type": "n8n-nodes-base.nocoDb",
      "typeVersion": 3,
      "position": [
        1300,
        190
      ],
      "credentials": {
        "nocoDbApiToken": {
          "id": "9gq205HbXOk9D3Jm",
          "name": "NocoDB Token account"
        }
      },
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "\n// Ktore szablony sa dzis na rzedzie (podzbior RRULE: DAILY/WEEKLY/MONTHLY).\nconst templates = $('Attach assignees to templates').first().json.templates || [];\nconst existing = $input.all().map(i => i.json).filter(r => r && r.Id)\n  .map(r => (r.title || '') + '|' + (r.due_date || ''));\nconst now = new Date();\nconst dow = ['SU', 'MO', 'TU', 'WE', 'TH', 'FR', 'SA'][now.getDay()];\nconst dom = now.getDate();\nconst month = now.toISOString().slice(0, 7);\nconst iso = d => d.toISOString().slice(0, 10);\nfunction dueToday(rrule) {\n  if (!rrule) return false;\n  const p = Object.fromEntries(rrule.split(';').map(s => s.split('=')));\n  const freq = (p.FREQ || '').toUpperCase();\n  if (freq === 'DAILY') return true;\n  if (freq === 'WEEKLY') return (p.BYDAY || '').split(',').includes(dow);\n  if (freq === 'MONTHLY') return parseInt(p.BYMONTHDAY || '1', 10) === dom;\n  return false;\n}\nconst out = [];\nfor (const t of templates) {\n  if (!dueToday(t.rrule)) continue;\n  const due = new Date(now.getTime() + (t.due_offset_days || 0) * 86400000);\n  const title = (t.title || 'Zadanie').replaceAll('{{month}}', month);\n  if (existing.includes(title + '|' + iso(due))) continue;   // idempotencja\n  out.push({ json: { template_id: t.Id, assignee_id: t.assignee_id, title,\n    description: t.description || '', due_date: iso(due) } });\n}\nreturn out;\n"
      },
