      "parameters": {
        "jsCode": "// Wejscie: wynik \"Get preferred employee\" albo lista handlowcow (fallback).\nconst rows = $input.all().map(i => i.json).filter(e => e && e.Id);\nrows.sort((a, b) => a.Id - b.Id);\nconst e = rows[0];\nconst preferred = !!$('Edit Fields').first().json.preferred_employee_id;\nif (!e) return [{ json: { assignee_id: null, assignee_email: null, assignee_name: null, reason: 'no available employee' } }];\nreturn [{ json: { assignee_id: e.Id, assignee_email: e.email, assignee_name: e.full_name,\n                  reason: preferred ? 'preferred employee' : 'default for role' } }];\n"
      },
