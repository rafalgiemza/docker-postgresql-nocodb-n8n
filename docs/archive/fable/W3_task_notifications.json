          "name": "NocoDB Token account"
        }
      }
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=__NOCODB_BASE_URL__/api/v2/tables/{{ $('Get one base').first().json.tables.find(t => t.title === 'tasks').id }}/links/cz6hud7pte2kr2l/records/{{ $('Normalize input').first().json.task_id }}?limit=200",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "nocoDbApiToken",
        "options": {}
      },
      "id": "get-task-assignee",
      "name": "Get task assignee",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        780,
        570
      ],
      "credentials": {
        "nocoDbApiToken": {
          "id": "9gq205HbXOk9D3Jm",
          "name": "NocoDB Token account"
        }
      }
    },
    {
      "parameters": {
        "numberInputs": 2
      },
      "id": "wait-for-task-and-assignee",
      "name": "Wait for task and assignee",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [
        1040,
        380
      ]
    },
    {
      "parameters": {
        "jsCode": "\nconst task = $('Get task').first().json;\nconst a = (($('Get task assignee').first().json.list) || [])[0];\nif (!a || !a.email) return [];\nreturn [{ json: {\n  to: a.email,\n  subject: `Nowe zadanie: ${task.title}`,\n  text: `Masz zadanie w CRM:\\n\\n${task.title}\\nTermin: ${task.due_date || '-'}\\n` +\n        `Zaplanowane na: ${task.scheduled_for || '-'}\\nPriorytet: ${task.priority || 'normal'}\\n\\n` +\n        `Szczegóły w NocoDB.`,\n  summary: `Powiadomienie wysłane do ${a.email}: ${task.title}`,\n  task_id: task.Id,\n} }];\n"
      },
      "id": "compose-notification",
      "name": "Compose notification",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1300,
        380
      ]
    },
    {
      "parameters": {
        "fromEmail": "info@coaction-test.pl",
        "toEmail": "={{ $json.to }}",
        "subject": "={{ $json.subject }}",
        "text": "={{ $json.text }}",
        "options": {}
      },
      "id": "send-task-notification",
      "name": "Send task notification",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
