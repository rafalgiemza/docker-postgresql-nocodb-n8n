        "projectId": "={{ $('Get one base').first().json.id }}",
        "table": "={{ $('Get one base').first().json.tables.find(t => t.title === 'activities').id }}",
        "operation": "create",
        "dataToSend": "defineBelow",
        "fieldsUi": {
