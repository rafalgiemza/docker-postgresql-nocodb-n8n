      "typeVersion": 2,
      "position": [
        0,
        190
      ],
      "webhookId": "wh-w3-task-notify"
    },
    {
      "parameters": {
        "inputSource": "passthrough"
      },
      "id": "notify-about-task-input",
      "name": "Notify about task: input",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        0,
        570
      ]
    },
    {
      "parameters": {
        "jsCode": "\n// Dwa wejscia: webhook tabeli tasks (reczne zmiany w UI) albo podflow (task_id).\nconst j = $input.first().json;\nif (j.task_id) return [{ json: { task_id: j.task_id } }];\nconst b = j.body || j;\nconst t = b.type || '';\nconst row = (b.data && b.data.rows && b.data.rows[0]) || {};\nconst prev = (b.data && b.data.previous_rows && b.data.previous_rows[0]) || {};\nconst id = o => (o && (o.Id || (Array.isArray(o) && o[0] && o[0].Id))) || null;\nif (!row.Id) return [];\nif (t.includes('update')) {\n  // Aktualizacje powiadamiamy tylko, gdy da sie stwierdzic zmiane odpowiedzialnego.\n  const cur = id(row.assignee), old = id(prev.assignee);\n  if (!cur || cur === old) return [];\n}\nreturn [{ json: { task_id: row.Id } }];\n"
      },
      "id": "normalize-input",
      "name": "Normalize input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        260,
        380
      ]
    },
    {
      "parameters": {
        "authentication": "nocoDbApiToken",
        "resource": "base",
        "operation": "get",
        "workspaceId": {
          "__rl": true,
          "value": "wpgg1mff",
          "mode": "list",
          "cachedResultName": "CoAction Workspace"
        },
        "projectId": {
          "__rl": true,
          "value": "p6w78auzu6sjdoo",
