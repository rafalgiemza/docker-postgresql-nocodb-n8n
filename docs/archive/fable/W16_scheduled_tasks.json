        "projectId": "={{ $('Get one base').first().json.id }}",
        "table": "={{ $('Get one base').first().json.tables.find(t => t.title === 'tasks').id }}",
        "operation": "getAll",
        "returnAll": true,
        "options": {
          "where": "=(status,eq,scheduled)~and(scheduled_for,le,{{ $now.toFormat('yyyy-MM-dd') }})"
        }
      },
      "id": "get-scheduled-tasks-that-are-due",
      "name": "Get scheduled tasks that are due",
      "type": "n8n-nodes-base.nocoDb",
      "typeVersion": 3,
