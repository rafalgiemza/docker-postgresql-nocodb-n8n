      "position": [
        780,
        190
      ],
      "credentials": {
        "nocoDbApiToken": {
          "id": "9gq205HbXOk9D3Jm",
          "name": "NocoDB Token account"
        }
      }
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=__NOCODB_BASE_URL__/api/v2/tables/{{ $('Get one base').first().json.tables.find(t => t.title === 'tasks').id }}/links/cz6hud7pte2kr2l/records/{{ $json.Id }}?limit=200",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "nocoDbApiToken",
        "options": {}
      },
      "id": "get-task-assignee",
      "name": "Get task assignee",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        1040,
        190
      ],
      "credentials": {
        "nocoDbApiToken": {
          "id": "9gq205HbXOk9D3Jm",
          "name": "NocoDB Token account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "\nconst tasks = $('Get scheduled tasks that are due').all();\nconst res = $input.all();\nconst today = new Date().toISOString().slice(0, 10);\nconst out = [];\nres.forEach((r, i) => {\n  const t = tasks[i].json;\n  const a = ((r.json.list) || [])[0];\n  if (!a) return;   // zadanie bez odpowiedzialnego: tylko zmiana statusu\n  out.push({ json: { task_id: t.Id, title: t.title, scheduled_for: t.scheduled_for,\n                     preferred_employee_id: a.Id, original_name: a.full_name,\n                     original_email: a.email, on_date: today } });\n});\nreturn out;\n"
      },
      "id": "prepare-reminder",
      "name": "Prepare reminder",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1300,
        190
      ]
    },
    {
      "parameters": {
        "source": "database",
        "workflowId": {
          "__rl": true,
          "value": "__W15_WORKFLOW_ID__",
          "mode": "id"
        },
        "mode": "each",
        "options": {
          "waitForSubWorkflow": true
        }
      },
      "id": "resolve-who-should-be-reminded-absences",
      "name": "Resolve who should be reminded (absences)",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.1,
      "position": [
        1560,
        190
      ]
    },
    {
      "parameters": {
        "jsCode": "\nconst src = $('Prepare reminder').all();\nconst res = $input.all();\nreturn res.map((r, i) => {\n  const s = src[i].json, a = r.json;\n  const to = a.assignee_email || s.original_email;\n  const sub = a.assignee_id && a.assignee_name !== s.original_name\n    ? ` (zastępstwo za ${s.original_name})` : '';\n  return { json: { to, task_id: s.task_id,\n    subject: `Zadanie na dziś: ${s.title}`,\n    text: `Zadanie zaplanowane na ${s.scheduled_for} jest już do zrobienia${sub}:\\n\\n${s.title}\\n\\nSzczegóły w NocoDB.`,\n    summary: `Przypomnienie o zadaniu wysłane do ${to}: ${s.title}` } };\n});\n"
      },
      "id": "compose-reminder",
      "name": "Compose reminder",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1820,
        190
      ]
    },
    {
      "parameters": {
        "fromEmail": "info@coaction-test.pl",
        "toEmail": "={{ $json.to }}",
        "subject": "={{ $json.subject }}",
        "text": "={{ $json.text }}",
        "options": {}
      },
      "id": "send-due-task-reminder",
      "name": "Send due-task reminder",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
