        520,
        190
      ],
      "credentials": {
        "nocoDbApiToken": {
          "id": "9gq205HbXOk9D3Jm",
          "name": "NocoDB Token account"
        }
      }
    },
    {
      "parameters": {
        "authentication": "nocoDbApiToken",
        "workspaceId": "={{ $('Get one base').first().json.workspace_id }}",
        "projectId": "={{ $('Get one base').first().json.id }}",
        "table": "={{ $('Get one base').first().json.tables.find(t => t.title === 'tasks').id }}",
        "operation": "update",
        "id": "={{ $json.Id }}",
        "dataToSend": "defineBelow",
