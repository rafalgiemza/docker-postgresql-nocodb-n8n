    {
      "parameters": {
        "numberInputs": 7
      },
      "id": "49101a59-d98b-49f9-a410-ee4b974cab4c",
      "name": "Merge fetches",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
