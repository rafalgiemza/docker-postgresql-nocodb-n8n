    {
      "parameters": {
        "jsCode": "// Call offer-service nie ustawia Content-Disposition, a URL /render nie ma\n// nazwy pliku - n8n zapisuje binarke bez fileName/rozszerzenia. Ustawiamy je\n// tu recznie, biorac rozszerzenie z szablonu (file[0].title), zeby wgrany\n// plik mial to samo rozszerzenie co szablon (pptx/docx), nie zadne.\nconst offerRow = $('Button: Generate offer').first().json.body.data.rows[0];\nconst templateFile = ($('Get offer template').first().json.file || [])[0];\nconst nameOrUrl = templateFile?.title || templateFile?.url || '';\nconst ext = (nameOrUrl.split('.').pop() || 'pptx').toLowerCase();\nconst safeTitle = (offerRow.title || `offer-${offerRow.Id}`).replace(/[^\\w\\-. ]+/g, '_');\nconst fileName = `${safeTitle}.${ext}`;\n\nconst items = $input.all();\nfor (const item of items) {\n  if (item.binary?.offer) {\n    item.binary.offer.fileName = fileName;\n  }\n}\nreturn items;"
      },
