        1440,
        3120
      ]
    },
    {
      "parameters": {
        "jsCode": "const offerRow = $('Button: Generate offer').first().json.body.data.rows[0];\nconst offerId = offerRow.Id;\nconst leadId = offerRow.leads?.Id;\n\nconst lead = $('Get lead').first().json;\nconst company = $('Get company').first().json || {};\n\nconst allParticipants = $('Fetch participants').all().map(i => i.json);\nconst participants = allParticipants.filter(p => p.leads?.Id === leadId);\n\nconst allAssessments = $('Fetch assessments').all().map(i => i.json);\nconst allRecommendations = $('Fetch recommendations').all().map(i => i.json);\nconst allPackages = $('Fetch recommendation_packages').all().map(i => i.json);\nconst allTrainingDescriptions = $('Fetch training_descriptions').all().map(i => i.json);\nconst allMeetings = $('Fetch meetings').all().map(i => i.json);\n\n// Najnowszy wg podanych pol (kolejnosc = priorytet), konwencja v3: sort=-UpdatedAt.\nconst latestBy = (rows, dateFields) => rows.slice().sort((a, b) => {\n  const av = dateFields.map(f => a[f]).find(v => v) ?? '';\n  const bv = dateFields.map(f => b[f]).find(v => v) ?? '';\n  return String(bv).localeCompare(String(av));\n})[0];\n\nconst leadMeetings = allMeetings.filter(m => m.leads?.Id === leadId);\nconst latestMeeting = latestBy(leadMeetings, ['starts_at', 'UpdatedAt', 'CreatedAt']) ?? {};\n\nconst participantData = participants.map(p => {\n  const asses = allAssessments.filter(a => a.participants?.Id === p.Id);\n  const a = latestBy(asses, ['UpdatedAt', 'CreatedAt']) ?? {};\n  const scores = { o: a.cefr_overall, r: a.cefr_range, a: a.cefr_accuracy, f: a.cefr_fluency, c: a.cefr_communication };\n\n  const recs = allRecommendations.filter(r => r.participants?.Id === p.Id);\n  const rec = latestBy(recs, ['UpdatedAt', 'CreatedAt']) ?? {};\n\n  return {\n    full_name: p.full_name,\n    position: p.position,\n    a: scores,\n    assessment: { ...scores, needs_summary: a.needs_summary, strengths: a.strengths, gaps: a.gaps, title: a.title },\n    recommendation: { type: rec.type, headline: rec.headline, rationale: rec.rationale, priority: rec.priority },\n    _recommendationId: rec.Id,\n  };\n});\n\n// Modul flat: repeat:module w szablonie nie obsluguje zagniezdzonych list -\n// jeden wiersz per (uczestnik, modul), patrz nocodb_crm_schema_v3.md \"Co sie zmienia w W9\".\nconst modules = [];\nfor (const p of participantData) {\n  if (p._recommendationId == null) continue;\n  const packages = allPackages\n    .filter(pkg => pkg.recommendations?.Id === p._recommendationId)\n    .sort((x, y) => (x.sort_order ?? 0) - (y.sort_order ?? 0));\n  for (const pkg of packages) {\n    const td = allTrainingDescriptions.find(t => t.Id === pkg.training_descriptions?.Id) ?? {};\n    modules.push({\n      sort_order: pkg.sort_order,\n      hours: pkg.hours_in_package,\n      mode: pkg.training_group_size,\n      title: td.title,\n      goal_statement: td.learning_goal,\n      participant_name: p.full_name,\n    });\n  }\n}\n\nconst participant = participantData.map(({ _recommendationId, ...rest }) => rest);\n\nconst data = {\n  lead: {\n    contact_name: lead.lead_name,\n    type: lead.lead_type,\n    contact_email: lead.contact_email,\n    contact_phone: lead.contact_phone,\n    industry: lead.industry,\n    notes: lead.notes,\n  },\n  company: {\n    name: company.name,\n    industry: company.industry,\n    notes: company.notes,\n    communication_processes: company.communication_processes,\n    business_impact: company.business_impact,\n  },\n  meeting: {\n    goals: latestMeeting.goals,\n    challenges: latestMeeting.challenges,\n    business_context: latestMeeting.business_context,\n    communication_situations: latestMeeting.communication_situations,\n  },\n  offer: {\n    date: $now.toFormat('dd.MM.yyyy'),\n    price: offerRow.total_price,\n    hours: offerRow.hours,\n    variant: offerRow.product_type ?? '',\n    participants_count: participant.length,\n  },\n  participant,\n  module: modules,\n};\n\nreturn [{ json: { offer_id: offerId, lead_id: leadId, data } }];"
      },
