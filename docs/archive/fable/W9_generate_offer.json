            {
              "id": "d-lead",
              "name": "data.lead",
              "type": "object",
              "value": "={{ Object.fromEntries(Object.entries($('Button: Generate offer').first().json.body.data.rows[0]).filter(([k, v]) => !k.startsWith('_nc_m2m_') && typeof v !== 'object')) }}"
            },
            {
              "id": "d-company",
              "name": "data.company",
              "type": "object",
              "value": "={{ $('Button: Generate offer').first().json.body.data.rows[0].Company ?? {} }}"
            },
            {
              "id": "d-participant",
              "name": "data.participant",
              "type": "array",
              "value": "={{ (() => { const asses = $('Fetch assessments').all().map(i => i.json).filter(a => a.Id != null); return ($('Button: Generate offer').first().json.body.data.rows[0]._nc_m2m_Leads_Participants ?? []).map(x => x.Participants).map(p => { const a = asses.filter(s => (s.Participant?.Id ?? s._nc_m2m_Assesments_Participants?.[0]?.Participants_id) === p.Id).sort((m, n) => String(n.UpdatedAt ?? n.CreatedAt ?? '').localeCompare(String(m.UpdatedAt ?? m.CreatedAt ?? '')))[0] ?? {}; const scores = { o: a.cefr_overall, r: a.cefr_range, a: a.cefr_accuracy, f: a.cefr_fluency, c: a.cefr_communication }; const needs = a.needs_summary ?? p.needs_summary; return { full_name: p.full_name, position: p.position, needs_summary: needs, a: scores, assessment: { ...scores, position: p.position, needs_summary: needs, title: a.title, level: a.Level } }; }); })() }}"
            },
            {
              "id": "d-testimonial",
              "name": "data.testimonial",
              "type": "array",
              "value": "={{ ($('Button: Generate offer').first().json.body.data.rows[0]._nc_m2m_Leads_Testimonials ?? []).map(x => x.Testimonials).map(t => ({ ...t, name: t.client_name })) }}"
            },
            {
              "id": "d-offer",
              "name": "data.offer",
              "type": "object",
              "value": "={{ (() => { const L = $('Button: Generate offer').first().json.body.data.rows[0]; return { date: $now.toFormat('dd.MM.yyyy'), price: L.value ?? '', hours: L.training_hours ?? '', variant: L.label ?? '', participants_count: (L._nc_m2m_Leads_Participants ?? []).length }; })() }}"
            }
          ]
        },
        "options": {}
