    {
      "parameters": {
        "jsCode": "// Sklej rationale z wybranych pakietow core (z dopiskiem o formacie sesji,\n// stala fraza dla wszystkich core - w NocoDB nie ma na to osobnego pola) i\n// others (bez dopisku - to jednorazowe dodatki, nie mają cyklu sesji).\n// Tytul/opis biora sie z katalogu package_variants_cores/others, godziny z\n// konkretnie wybranej instancji (selected_package_variants_cores/others.hours).\nconst cores = $('Tag core with hours').isExecuted ? $('Tag core with hours').all().map(x => x.json) : [];\nconst others = $('Tag other with hours').isExecuted ? $('Tag other with hours').all().map(x => x.json) : [];\n\nconst lines = [];\nfor (const c of cores) {\n  const f = c.fields || {};\n  if (!f.name) continue;\n  lines.push(`✅ ${f.name} – ${c._hours} godzin (2x60 min lub 1x90 min)`);\n  lines.push((f.description || '').trim());\n}\nfor (const o of others) {\n  const f = o.fields || {};\n  if (!f.name) continue;\n  lines.push(`✅ ${f.name} – ${o._hours} godzin`);\n  lines.push((f.description || '').trim());\n}\n\nreturn [{\n  json: {\n    recommendation_id: $('Button: Uzupełnij rationale').first().json.body.data.rows[0].Id,\n    rationale: lines.join('\\n'),\n    has_packages: (cores.length + others.length) > 0\n  }\n}];"
      },
      "id": "6d8bcdb9-7ae3-42ed-a8ac-311d6a992745",
      "name": "Build rationale",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -400,
        1408
      ]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.has_packages }}",
              "value2": true
            }
          ]
