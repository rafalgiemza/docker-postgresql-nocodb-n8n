        }
      }
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "=__NOCODB_BASE_URL__/api/v2/tables/__TBL_CRM_EXPORTS__/records",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "nocoDbApiToken",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify([{ Id: $('Export from button').first().json.export_id, new_crm: $json.body, report: 'Wyeksportowano wierszy: ' + $('Export CRM from Postgres (crm-legacy-service)').first().json.headers['x-rows'], completion_status: 'done' }]) }}",
        "options": {}
      },
      "id": "w23-07",
      "name": "Save file and set status: done",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
