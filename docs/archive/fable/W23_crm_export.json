        "options": {
          "response": {
            "response": {
              "fullResponse": true,
              "responseFormat": "file",
              "outputPropertyName": "new_crm"
            }
          },
          "timeout": 300000
        }
      },
      "id": "w23-05",
      "name": "Export CRM from Postgres (crm-legacy-service)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
