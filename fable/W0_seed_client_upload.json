{
  "name": "W0 - Seed CRM via upload form",
  "description": "Forma dla klienta: uploaduj Excel + podaj NocoDB server → seed-service zasilaj bazę",
  "nodes": [
    {
      "parameters": {
        "method": "POST",
        "url": "=http://seed-service:8000/seed-upload?nc_url={{ encodeURIComponent($json.body.nc_url) }}&nc_token={{ encodeURIComponent($json.body.nc_token) }}&nc_base_id={{ encodeURIComponent($json.body.nc_base_id) }}&dry_run={{ $json.body.dry_run === 'true' }}",
        "sendBody": true,
        "contentType": "multipart-form-data",
        "bodyParameters": {
          "parameters": [
            {
              "parameterType": "formBinaryData",
              "name": "file",
              "inputDataFieldName": "file"
            }
          ]
        },
        "options": {}
      },
      "id": "0a5a6cde-908e-470d-8e3d-c41d31f0a8c6",
      "name": "Call seed-service /seed-upload",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1792,
        336
      ],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "result",
              "name": "result",
              "type": "object",
              "value": "={{ (() => { const resp = $json.json ?? {}; return { success: !resp.error, file_name: $json.body.file?.name ?? '?', dry_run: $json.body.dry_run === 'true', status: resp.error ? '❌ ERROR' : resp.message ?? '✓ Done', total_records: resp.total_records ?? 0, created_leads: resp.created_leads ?? 0, created_companies: resp.created_companies ?? 0, created_participants: resp.created_participants ?? 0, skipped: resp.skipped ?? 0, errors_count: (resp.errors ?? []).length, first_errors: (resp.errors ?? []).slice(0, 3), }; })() }}"
            }
          ]
        },
        "options": {}
      },
      "id": "8137d8ab-523b-4e00-a34c-e2e344b9ec2e",
      "name": "Format response",
