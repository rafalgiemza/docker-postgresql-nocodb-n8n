{
  "name": "W0 - Seed via seed-service (HTTP)",
  "description": "Zasilaj NocoDB z Excel - przez seed-service zamiast inline kodu",
  "nodes": [
    {
      "parameters": {},
      "id": "trigger",
      "name": "Manual Trigger",
